{
  "manifest_version": 3,
  "name": "CareerFlow Job Capture",
  "version": "1.0.0",
  "description": "Automatically save job applications to your CareerFlow workspace.",
  "permissions": ["storage", "activeTab", "tabs"],
  "host_permissions": ["https://careerflow-one.vercel.app/*", "http://localhost:8000/*", "<all_urls>"],
  "action": {"default_popup": "popup.html", "default_title": "Save to CareerFlow"},
  "background": {"service_worker": "background.js"},
  "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}]
}
