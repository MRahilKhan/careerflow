# ============================================================
# CareerFlow Backend Environment
# ============================================================

# Generate a strong random value of at least 32 characters.
CAREERFLOW_SECRET_KEY=replace-with-a-long-random-secret

# PostgreSQL / Neon database connection.
# Set the real value in Vercel Environment Variables.
CAREERFLOW_DATABASE_URL=postgresql+psycopg://username:password@host/database

# Allowed frontend origins, separated by commas.
CAREERFLOW_ALLOWED_ORIGINS=http://localhost:5173,https://careerflow-liart.vercel.app
